# ================================
# CRM Sales Platform — Root .env.example
# ================================
# Copy to .env and fill in values

# Application
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
# Application runtime account — DML only (SELECT/INSERT/UPDATE/DELETE, LOCK TABLES)
DB_USERNAME=crm_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
# MySQL root password — separate from app account password
# Required for first-time container init and healthcheck
DB_ROOT_PASSWORD=YOUR_ROOT_PASSWORD_HERE
DB_DATABASE=crm_sales
# Migration account — run as: DB_USERNAME=crm_migrator DB_PASSWORD=... pnpm migration:run
# DB_MIGRATOR_PASSWORD=YOUR_MIGRATOR_PASSWORD_HERE

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM for sensitive fields — required in production)
# Generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Third-party callback signature secret (materials upload and generic provider callbacks)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_CALLBACK_SECRET=

# Cloud transcription callback push
# Callback URL: https://your-domain.com/api/v1/recordings/transcription/callback
CLOUD_TRANSCRIPTION_CALLBACK_TOKEN=
CLOUD_TRANSCRIPTION_CALLBACK_SALT=
CLOUD_TRANSCRIPTION_CALLBACK_TIMESTAMP_TOLERANCE_MS=900000
CLOUD_TRANSCRIPTION_CALLBACK_BODY_LIMIT=2mb

# Unicom call detail/recording callbacks
# Public base URL used by the settings page/API to generate vendor callback URLs.
# Leave empty to infer the backend request host when available.
PUBLIC_CALLBACK_BASE_URL=https://your-domain.com
# Account-level callback URLs:
#   https://your-domain.com/api/v1/unicom/records
#   https://your-domain.com/api/v1/unicom/transcriptions
# Canonical account-level credentials sent to Unicom. Keep these stable after vendor setup.
UNICOM_CALLBACK_TOKEN=
UNICOM_CALLBACK_SALT=
# Optional phone-specific overrides. Do not set these unless intentionally overriding one phone.
# Legacy split global variables UNICOM_CALL_CALLBACK_* and UNICOM_TRANSCRIPTION_CALLBACK_*
# are compatibility fallback only; prefer UNICOM_CALLBACK_TOKEN/SALT for account-level callbacks.
# UNICOM_CALL_CALLBACK_TOKEN_13800138000=
# UNICOM_CALL_CALLBACK_SALT_13800138000=
# UNICOM_TRANSCRIPTION_CALLBACK_TOKEN_13800138000=
# UNICOM_TRANSCRIPTION_CALLBACK_SALT_13800138000=
UNICOM_CALLBACK_TIMESTAMP_TOLERANCE_MS=900000

# HTTP body parser limits
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb

# AI / DashScope (Qwen)
# Fill only DASHSCOPE_API_KEY before deployment.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.6-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
VECTOR_DB_PATH=./data/vectors.db

# OSS / S3-compatible storage (recordings, materials)
# For Alibaba Cloud OSS: https://oss-cn-hangzhou.aliyuncs.com
# For MinIO local dev:    http://localhost:9000 (set OSS_FORCE_PATH_STYLE=true)
OSS_ENDPOINT=
OSS_REGION=us-east-1
OSS_BUCKET=crm-call-recordings
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Set to true for MinIO / path-style S3 endpoints
OSS_FORCE_PATH_STYLE=false
