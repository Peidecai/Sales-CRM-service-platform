{
  "name": "crm-sales-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI 智能 CRM 销售管理系统 Monorepo",
  "scripts": {
    "dev:web": "pnpm --filter @crm/web dev",
    "dev:server": "pnpm --filter @crm/server start:dev",
    "build": "pnpm --filter @crm/shared build && pnpm --filter @crm/server build && pnpm --filter @crm/web build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
