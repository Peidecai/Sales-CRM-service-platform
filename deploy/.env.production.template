# =============================================================================
# CRM Sales Platform — Production Environment Variables
# =============================================================================
# Copy to project root as .env, then fill in secrets.
#
# Auto-generate secrets (run on ECS):
#   openssl rand -hex 32     → for JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY
#   openssl rand -base64 16  → for DB passwords, REDIS_PASSWORD
# =============================================================================

# ---- Application ----
NODE_ENV=production
PORT=3000

# ---- CORS ----
# Replace with your actual domain or ECS public IP
CORS_ORIGINS=http://120.26.108.226

# ---- Database (MySQL 8.0) ----
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm_sales
DB_CONNECTION_LIMIT=20
# Runtime app account (DML only)
DB_USERNAME=crm_user
DB_PASSWORD=CHANGE_ME_crm_user_password
# Root — used only for initial container bootstrap
DB_ROOT_PASSWORD=CHANGE_ME_root_password
# Migration account (DDL) — used by deploy.sh
DB_MIGRATOR_USERNAME=crm_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_migrator_password
# SSL — set to true if using Alibaba Cloud RDS
DB_SSL=false

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0

# ---- JWT ----
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Encryption (AES-256-GCM) ----
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_encryption_key

# ---- Object Storage (MinIO in Docker) ----
OSS_ENDPOINT=http://minio:9000
OSS_REGION=us-east-1
OSS_BUCKET=crm-call-recordings
OSS_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
OSS_ACCESS_KEY_SECRET=CHANGE_ME_minio_secret_key
OSS_FORCE_PATH_STYLE=true

# ---- Swagger (disable in production) ----
SWAGGER_ENABLED=false

# ---- AI / DashScope (optional) ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---- WeChat Mini Program (optional) ----
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ---- Docker Compose Port Mapping ----
# In production, only port 80 is exposed externally
# These are kept for reference / docker-compose overrides
SERVER_PORT=3000
WEB_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
