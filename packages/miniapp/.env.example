# Backend API base URL (no trailing slash)
# Dev:  http://localhost:3000/api/v1
# Prod: https://api.yourdomain.com/api/v1  (must be an ICP-registered HTTPS domain)
VITE_API_BASE_URL=http://localhost:3000/api/v1
