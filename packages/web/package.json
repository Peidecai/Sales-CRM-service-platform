{
  "name": "@crm/web",
  "version": "1.0.0",
  "description": "CRM Sales Platform — Vue 3 Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.ts,.tsx --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "axios": "^1.6.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.5.0",
    "markdown-it": "^14.1.1",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.21.0",
    "happy-dom": "^20.8.3",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.0.0"
  }
}
